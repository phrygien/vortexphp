{
  "name": "mecene/app",
  "description": "Squelette d'application officiel pour le micro-framework PHP 8.3+ Mecene.",
  "keywords": ["framework", "mecene", "skeleton", "php83"],
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "mecene/framework": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"foreach (['storage/cache', 'storage/logs', 'database'] as $dir) { if (!is_dir($dir)) mkdir($dir, 0775, true); @chmod($dir, 0775); }\""
    ]
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0-dev"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
