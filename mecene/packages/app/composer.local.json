{
  "name": "mecene/app",
  "description": "Exemple de composer.json pour le développement local en monorepo avant publication sur Packagist.",
  "type": "project",
  "license": "MIT",
  "repositories": [
    {
      "type": "path",
      "url": "../framework",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": "^8.3",
    "mecene/framework": "@dev"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"foreach (['storage/cache', 'storage/logs', 'database'] as $dir) { if (!is_dir($dir)) mkdir($dir, 0775, true); @chmod($dir, 0775); }\""
    ]
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0-dev"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
