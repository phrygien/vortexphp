{
  "name": "mecene/framework",
  "description": "Le cœur du micro-framework PHP 8.3+ Mecene : conteneur PSR-11, routeur, middlewares, Mecene, ORM, migrations et CLI Artisan.",
  "keywords": ["framework", "mecene", "php83", "psr-11", "psr-7", "orm", "micro-framework"],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "nyholm/psr7": "^1.8",
    "psr/container": "^2.0",
    "psr/http-server-middleware": "^1.0",
    "symfony/console": "^7.1",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "Mecene\\": "src/"
    },
    "files": [
      "src/Foundation/helpers.php"
    ]
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0-dev"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
